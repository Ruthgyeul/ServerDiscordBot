{
  "name": "server-discord-bot",
  "version": "1.0.0",
  "description": "Discord bot for managing a Linux host: systemd services, hosted websites, allowlisted commands and files, with config-driven monitoring and alerts.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"src/**/*.test.ts\"",
    "deploy": "node dist/deploy-commands.js",
    "deploy:dev": "tsx src/deploy-commands.ts",
    "deploy:clear": "node dist/deploy-commands.js --clear",
    "deploy:clear:dev": "tsx src/deploy-commands.ts --clear",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "systeminformation": "^5.23.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  },
  "license": "MIT"
}
