# ─────────────────────────────────────────────────────────────────────────────
#  ServerDiscordBot — environment configuration
#
#  Copy this file to `.env` and fill in the values. Never commit the real
#  `.env` (it is git-ignored).
#
#  This file holds the bot's *identity, secrets and host-access mode*.
#  Everything about the server it manages — which services, websites, commands
#  and files exist — lives in `config/config.json` instead.
#
#  After editing either file, run `/config reload` in Discord to apply it.
#  Values marked [restart] are only read at startup.
# ─────────────────────────────────────────────────────────────────────────────

# ── Discord credentials ──────────────────────────────────────────────────────

# Bot token (Bot > Reset Token in the Developer Portal). [restart]
DISCORD_TOKEN=

# Application (client) ID — used to register slash commands.
DISCORD_CLIENT_ID=

# Guild (server) ID. If set, slash commands register instantly to this guild
# only. Leave empty to register commands globally (~1h propagation).
DISCORD_GUILD_ID=

# Channel ID where automated alerts (resource / service / website / TLS) go.
# Also receives the startup / shutdown notice.
ALERT_CHANNEL_ID=

# Optional channel receiving an audit trail of every privileged action
# (service control, /run exec, /config reload, alert muting). Leave empty to
# keep the trail in the journal only.
AUDIT_CHANNEL_ID=

# ── Access control ───────────────────────────────────────────────────────────

# Comma-separated Discord user IDs allowed to run privileged commands
# (service start/stop/restart, /run, /file, /config, log access).
ADMIN_USER_IDS=

# Comma-separated Discord role IDs whose members may run privileged commands.
ADMIN_ROLE_IDS=

# ── Bot identity & presence ──────────────────────────────────────────────────
# The Discord account's username and avatar are set in the Developer Portal.
# Everything the bot renders itself is configured here.

# Display name used in embeds, /help and the health-check User-Agent.
BOT_NAME=ServerDiscordBot

# One-line description shown in /help.
BOT_DESCRIPTION=Linux host & service management bot

# Presence indicator: online | idle | dnd | invisible
BOT_PRESENCE_STATUS=online

# Activity verb: Playing | Watching | Listening | Competing | Custom
BOT_ACTIVITY_TYPE=Watching

# Activity text, e.g. "the server 🖥️" -> "Watching the server 🖥️".
BOT_ACTIVITY_TEXT=the server 🖥️

# Accent color for informational embeds, as a hex code. Status colors
# (green/yellow/red) are fixed so their meaning never changes.
BOT_ACCENT_COLOR=#5865F2

# Optional footer added to every embed. Leave empty for none.
BOT_EMBED_FOOTER=

# ── Host access ──────────────────────────────────────────────────────────────

# Prefix systemctl/journalctl with `sudo -n`. Enable when the bot runs as an
# unprivileged user with a scoped sudoers rule (see README). Leave false when
# it runs as root or manages --user units.
SYSTEMCTL_SUDO=false

# Which systemd instance to talk to: system | user
SYSTEMCTL_SCOPE=system

# Default timeout for host commands, in milliseconds. Mutating service actions
# get double this.
COMMAND_TIMEOUT_MS=15000

# ── Runtime ──────────────────────────────────────────────────────────────────

# Path to the inventory file, relative to the project root. Leave unset to use
# config/config.json, falling back to config/config.example.json.
# CONFIG_PATH=config/config.json

# Log level: trace | debug | info | warn | error | fatal | silent  [restart]
LOG_LEVEL=info

# Set to "production" on the server; enables structured JSON logging. [restart]
NODE_ENV=production
