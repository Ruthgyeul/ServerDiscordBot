# ─────────────────────────────────────────────────────────────
#  ServerDiscordBot — environment configuration
#  Copy this file to `.env` and fill in the values.
#  Never commit the real `.env` (it is git-ignored).
# ─────────────────────────────────────────────────────────────

# Discord bot token (Bot > Reset Token in the Developer Portal)
DISCORD_TOKEN=

# Application (client) ID — used to register slash commands
DISCORD_CLIENT_ID=

# Guild (server) ID. If set, slash commands register instantly to this
# guild only. Leave empty to register commands globally (~1h propagation).
DISCORD_GUILD_ID=

# Channel ID where automated alerts (resource / service / website) are posted.
ALERT_CHANNEL_ID=

# Comma-separated Discord user IDs allowed to run privileged commands
# (service start/stop/restart, log access, etc.)
ADMIN_USER_IDS=

# Comma-separated Discord role IDs whose members may run privileged commands.
ADMIN_ROLE_IDS=

# ── Bot branding & presence ──────────────────────────────────────────────
# Display name used in embeds, /help title and the health-check User-Agent.
# (The actual Discord account username/avatar is set in the Developer Portal.)
BOT_NAME=ServerDiscordBot

# One-line description shown in /help.
BOT_DESCRIPTION=Linux host & service management bot

# Presence indicator: online | idle | dnd | invisible
BOT_PRESENCE_STATUS=online

# Activity verb shown under the bot's name:
#   Playing | Watching | Listening | Competing | Custom
BOT_ACTIVITY_TYPE=Watching

# Activity text, e.g. "the server 🖥️" -> "Watching the server 🖥️".
BOT_ACTIVITY_TEXT=the server 🖥️

# Optional footer text added to every embed the bot sends. Leave empty for none.
BOT_EMBED_FOOTER=

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Set to "production" on the server; enables JSON logging for journald.
NODE_ENV=production
