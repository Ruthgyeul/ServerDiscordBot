{
  "monitor": {
    "enabled": true,
    "intervalSeconds": 60,
    "alertCooldownMinutes": 15,
    "checks": {
      "resources": true,
      "services": true,
      "websites": true,
      "certificates": true,
      "failedUnits": false
    },
    "thresholds": {
      "cpuPercent": 85,
      "memoryPercent": 90,
      "diskPercent": 90,
      "certExpiryDays": 14,
      "responseMs": 3000,
      "cpuTempCelsius": 80
    },
    "ignoreMounts": ["/boot", "/boot/efi", "/snap"],
    "historyHours": 24
  },

  "services": [
    {
      "name": "nginx",
      "label": "Nginx",
      "unit": "nginx.service",
      "description": "Reverse proxy in front of every site",
      "critical": true
    },
    {
      "name": "web",
      "label": "Main site",
      "unit": "web.service",
      "description": "Front-end application behind the proxy",
      "critical": true
    },
    {
      "name": "api",
      "label": "API",
      "unit": "api.service",
      "description": "Backend service"
    }
  ],

  "websites": [
    {
      "name": "main",
      "label": "Main site",
      "url": "https://example.com",
      "expectStatus": 200,
      "timeoutMs": 8000,
      "checkCert": true,
      "service": "web"
    },
    {
      "name": "api",
      "label": "API health",
      "url": "https://api.example.com/health",
      "expectStatus": 200,
      "timeoutMs": 8000,
      "checkCert": true,
      "service": "api"
    }
  ],

  "commands": [
    {
      "name": "disk",
      "label": "Disk usage",
      "description": "Human-readable disk usage per filesystem",
      "command": "df",
      "args": ["-h"]
    },
    {
      "name": "memory",
      "label": "Memory usage",
      "description": "Free / used memory and swap",
      "command": "free",
      "args": ["-h"]
    },
    {
      "name": "nginx-test",
      "label": "Test nginx config",
      "description": "Validate the nginx configuration before a reload",
      "command": "nginx",
      "args": ["-t"],
      "sudo": true
    },
    {
      "name": "nginx-reload",
      "label": "Reload nginx",
      "description": "Apply a new nginx config without dropping connections",
      "command": "systemctl",
      "args": ["reload", "nginx.service"],
      "sudo": true,
      "confirm": true
    },
    {
      "name": "docker-ps",
      "label": "Docker containers",
      "description": "Running containers and their status",
      "command": "docker",
      "args": ["ps", "--format", "table {{.Names}}\\t{{.Status}}\\t{{.Ports}}"],
      "timeoutMs": 20000
    },
    {
      "name": "tail-syslog",
      "label": "Tail syslog",
      "description": "Last N lines of the system log. argPattern constrains N to a number, so allowing arguments cannot turn this into a request for an arbitrary file.",
      "command": "tail",
      "args": ["-n", "50", "/var/log/syslog"],
      "allowArgs": true,
      "argPattern": "^[0-9]{1,4}$"
    }
  ],

  "files": [
    {
      "name": "nginx-error",
      "label": "Nginx error log",
      "path": "/var/log/nginx/error.log",
      "description": "Proxy-level failures (502/504 origins)",
      "maxLines": 200
    },
    {
      "name": "nginx-access",
      "label": "Nginx access log",
      "path": "/var/log/nginx/access.log",
      "maxLines": 200
    }
  ],

  "disabledCommands": []
}
